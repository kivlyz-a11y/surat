# ==============================================================================
# ENVIRONMENT VARIABLES UNTUK DEPLOYMENT COOLIFY (SIM-SURAT)
# ==============================================================================
# Salin seluruh teks di bawah ini dan tempel (paste) ke tab:
# Coolify Dashboard -> [Nama Resource/App Anda] -> Environment Variables
# ==============================================================================

# 1. Lingkungan Aplikasi (Wajib 'production')
CI_ENVIRONMENT=production

# 2. URL Domain Aplikasi
# Sesuaikan dengan domain Anda atau gunakan IP / sslip.io:
# Contoh dengan domain: https://surat.instansi.go.id/
# Contoh dengan sslip.io: http://surat.103.123.45.67.sslip.io/
# Contoh dengan IP:Port: http://103.123.45.67:8080/
APP_URL=http://localhost:8080/
app.baseURL=http://localhost:8080/
app.appTimezone=Asia/Jakarta

# 3. Konfigurasi Port Host (Jika deploy via Docker Compose)
APP_PORT=8080
DB_EXTERNAL_PORT=3307

# 4. Konfigurasi Database (MariaDB / MySQL di Coolify)
# Jika menggunakan docker-compose.yml: DB_HOST cukup isi 'db'
# Jika menggunakan database terpisah di Coolify: isi dengan nama service DB / IP Host
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db_nomor_surat
DB_USER=user_surat
DB_PASSWORD=surat_secret_password123
DB_ROOT_PASSWORD=root_secret_password123

# Mapping ke variabel internal CodeIgniter 4
database.default.hostname=db
database.default.database=db_nomor_surat
database.default.username=user_surat
database.default.password=surat_secret_password123
database.default.DBDriver=MySQLi
database.default.port=3306
database.default.charset=utf8mb4
database.default.DBCollat=utf8mb4_unicode_ci

# 5. Konfigurasi Keamanan & CSRF
security.csrfProtection=session
security.tokenName=csrf_token_surat
security.cookieName=csrf_cookie_surat
security.expires=7200
security.regenerate=true
security.redirect=false

# 6. Batas Upload File (Ukuran Maksimal dalam Bytes, default 25MB)
app.uploadMaxBytes=26214400
