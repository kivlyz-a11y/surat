# ==============================================================================
# Environment Configuration untuk Docker / Coolify
# ==============================================================================

# Mode Environment (production / development)
CI_ENVIRONMENT=production

# URL domain aplikasi (contoh: https://surat.instansi.go.id/ atau http://localhost:8080/)
APP_URL=http://localhost:8080/
APP_PORT=8080

# Konfigurasi Database
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db_nomor_surat
DB_USER=user_surat
DB_PASSWORD=surat_secret_password123
DB_ROOT_PASSWORD=root_secret_password123
DB_EXTERNAL_PORT=3307

# Konfigurasi Keamanan & CSRF
security.csrfProtection=session
security.tokenName=csrf_test_name
security.cookieName=csrf_cookie_name
security.expires=7200
